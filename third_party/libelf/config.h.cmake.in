/* config.h - generated by CMake from config.h.cmake.in */

/* Define if you have a working mmap system call */
#cmakedefine HAVE_MMAP 1

/* Define if you have the ANSI C header files */
#define STDC_HEADERS 1

/* Define if you want ELF format sanity checks by default */
#define ENABLE_SANITY_CHECKS 1

/* Define if memmove() does not copy overlapping arrays correctly */
/* #undef HAVE_BROKEN_MEMMOVE */

/* Define if you have the catgets function (NLS not used) */
/* #undef HAVE_CATGETS */

/* Define if you have the dgettext function (NLS not used) */
/* #undef HAVE_DGETTEXT */

/* Define if you have the memset function */
#cmakedefine HAVE_MEMSET 1

/* Define if struct nlist is declared in <elf.h> or <sys/elf.h> */
/* #undef HAVE_STRUCT_NLIST_DECLARATION */

/* Define if Elf32_Dyn is declared in <link.h> */
/* #undef __LIBELF_NEED_LINK_H */

/* Define if Elf32_Dyn is declared in <sys/link.h> */
/* #undef __LIBELF_NEED_SYS_LINK_H */

/* Define to <elf.h> or <sys/elf.h> if one of them is present and usable */
@LIBELF_HEADER_ELF_H_DEFINE@

/* Define if you want 64-bit support */
#define __LIBELF64 1

/* Define if you want 64-bit support and are running IRIX */
/* #undef __LIBELF64_IRIX */

/* Define if you want 64-bit support and are running Linux (no Elf64_Addr) */
/* #undef __LIBELF64_LINUX */

/* Define if you want symbol versioning support */
@LIBELF_SYMBOL_VERSIONS_DEFINE@

/* Define if symbol versioning uses Sun section types (SHT_SUNW_*) */
@LIBELF_SUN_SYMBOL_VERSIONS_DEFINE@

/* Define if symbol versioning uses GNU section types (SHT_GNU_*) */
@LIBELF_GNU_SYMBOL_VERSIONS_DEFINE@

/* 64-bit signed integer type */
#define __libelf_i64_t @LIBELF_I64_T@

/* 64-bit unsigned integer type */
#define __libelf_u64_t unsigned @LIBELF_I64_T@

/* 32-bit signed integer type */
#define __libelf_i32_t @LIBELF_I32_T@

/* 32-bit unsigned integer type */
#define __libelf_u32_t unsigned @LIBELF_I32_T@

/* 16-bit signed integer type */
#define __libelf_i16_t @LIBELF_I16_T@

/* 16-bit unsigned integer type */
#define __libelf_u16_t unsigned @LIBELF_I16_T@

/* The number of bytes in a short */
#define SIZEOF_SHORT @LIBELF_SIZEOF_SHORT@

/* The number of bytes in an int */
#define SIZEOF_INT @LIBELF_SIZEOF_INT@

/* The number of bytes in a long */
#define SIZEOF_LONG @LIBELF_SIZEOF_LONG@

/* The number of bytes in a long long */
#define SIZEOF_LONG_LONG @LIBELF_SIZEOF_LONG_LONG@

/* Define if you have the ftruncate function */
#cmakedefine HAVE_FTRUNCATE 1

/* Define if you have the getpagesize function */
#cmakedefine HAVE_GETPAGESIZE 1

/* Define if you have the memcmp function */
#cmakedefine HAVE_MEMCMP 1

/* Define if you have the memcpy function */
#cmakedefine HAVE_MEMCPY 1

/* Define if you have the memmove function */
#cmakedefine HAVE_MEMMOVE 1

/* Define if you have the <ar.h> header file */
#cmakedefine HAVE_AR_H 1

/* Define if you have the <elf.h> header file */
#cmakedefine HAVE_ELF_H 1

/* Define if you have the <fcntl.h> header file */
#cmakedefine HAVE_FCNTL_H 1

/* Define if you have the <stdint.h> header file */
#cmakedefine HAVE_STDINT_H 1

/* Define if you have the <sys/elf.h> header file */
#cmakedefine HAVE_SYS_ELF_H 1

/* Define if you have the <unistd.h> header file */
#cmakedefine HAVE_UNISTD_H 1
